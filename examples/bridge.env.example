# OTLP/HTTP receiver: /v1/logs, /v1/traces, /healthz, /stats
EVIDRA_BRIDGE_LISTEN_ADDR=:4318

# OTLP/gRPC receiver. AgentGateway's tracing and access-log export default to 4317, and the
# access log is where a CEL-projected operation id arrives, so both signals are served.
EVIDRA_BRIDGE_GRPC_LISTEN_ADDR=:4317

# Append-only JSONL artifact: one normalized execution per line.
EVIDRA_BRIDGE_OBSERVATIONS=output/observations.jsonl

# How long a record seen on only one signal waits for the other before being emitted as a
# partial. 0 holds partials until shutdown flushes them.
EVIDRA_BRIDGE_MERGE_WAIT=30s

# Written onto every execution's source, so two receivers writing one store stay separable.
EVIDRA_BRIDGE_OBSERVER_ID=agentgateway-bridge
EVIDRA_BRIDGE_OBSERVER_VERSION=

# EVIDRA_BASE_URL and EVIDRA_API_KEY were removed, not deprecated: they pointed at the hosted
# ingest API that was deleted from the product. A knob for a nonexistent endpoint made a
# receiver that forwarded nothing look like one that was merely unconfigured.
